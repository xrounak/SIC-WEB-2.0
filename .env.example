# Copy to .env.local and fill in. Never commit real values.

# Public: safe in the browser. RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only: no NEXT_PUBLIC_ prefix, never import into client components.
# Used by the maintenance cron route only.
SUPABASE_SECRET_KEY=sb_secret_xxx
CRON_SECRET=generate-a-long-random-string
# Telegram alerts (not wired up yet).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
